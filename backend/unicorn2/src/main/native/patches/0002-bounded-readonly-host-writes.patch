+/* Host/API-only writes may update already-readonly RAM without changing
+ * the guest-visible topology. Keep FlatView clipping and MMIO dispatch. */
+static bool cpu_physical_mem_write_host(AddressSpace *as, hwaddr addr,
+                                         const uint8_t *buf, hwaddr len)
+{
+    if (len == 0) {
+        return true;
+    }
+    FlatView *fv = address_space_to_flatview(as);
+    hwaddr l = len, addr1;
+    MemoryRegion *mr = flatview_translate(as->uc, fv, addr, &addr1, &l,
+                                        true, MEMTXATTRS_UNSPECIFIED);
+    return flatview_write_continue(as->uc, fv, addr, MEMTXATTRS_UNSPECIFIED,
+                                   buf, len, addr1, l, mr, true) == MEMTX_OK;
+}
