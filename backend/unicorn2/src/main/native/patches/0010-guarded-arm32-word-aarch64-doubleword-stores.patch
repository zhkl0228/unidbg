+#if (defined(TARGET_ARM) && !defined(TARGET_AARCH64)) && UINTPTR_MAX == UINT64_MAX
+static QEMU_NOINLINE void store_stl_slow(CPUArchState *env, target_ulong addr,
+                                      uint32_t val, TCGMemOpIdx oi,
+                                      uintptr_t retaddr)
+{
+    store_helper(env, addr, val, oi, retaddr, MO_LEUL);
+}
+
 void helper_le_stl_mmu(CPUArchState *env, target_ulong addr, uint32_t val,
                        TCGMemOpIdx oi, uintptr_t retaddr)
 {
+    struct uc_struct *uc = env->uc;
+    unsigned a_bits = get_alignment_bits(get_memop(oi));
+    if (!(addr & ((1 << a_bits) - 1)) && !(addr & 3) &&
+            (addr & ~TARGET_PAGE_MASK) <= TARGET_PAGE_SIZE - 4 &&
+            !uc->snapshot_level && !HOOK_EXISTS(uc, UC_HOOK_MEM_WRITE)) {
+        uintptr_t mmu_idx = get_mmuidx(oi);
+        CPUTLBEntry *entry = tlb_entry(env, mmu_idx, addr);
+        if (tlb_addr_write(entry) == ((addr & TARGET_PAGE_MASK) | TLB_NOTDIRTY)) {
+            uintptr_t index = tlb_index(env, mmu_idx, addr);
+            CPUIOTLBEntry *io = &env_tlb(env)->d[mmu_idx].iotlb[index];
+            if (io->ram_section_index != UINT32_MAX) {
+                MemoryRegion *mr = memory_region_from_cached_ram_section(
+                        uc, io->ram_section_index);
+                if (mr && mr->ram && !mr->readonly && (mr->perms & UC_PROT_WRITE)) {
+                    notdirty_write(env_cpu(env), addr, 4, io, retaddr, entry, mr);
+                    stl_le_p((void *)((uintptr_t)addr + entry->addend), val);
+                    return;
+                }
+            }
+        }
+    }
+    store_stl_slow(env, addr, val, oi, retaddr);
+}
+#else
+void helper_le_stl_mmu(CPUArchState *env, target_ulong addr, uint32_t val,
+                       TCGMemOpIdx oi, uintptr_t retaddr)
+{
     store_helper(env, addr, val, oi, retaddr, MO_LEUL);
 }
+#endif

