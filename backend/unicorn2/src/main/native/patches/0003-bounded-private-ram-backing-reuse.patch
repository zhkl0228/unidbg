+/* Exact-size backing reuse preserves the allocator's trailing guard page.
+ * Total admission is capped at 1 MiB, including one host page per allocation.
+ * Non-host-page-sized buffers retain the original 64 KiB admission budget.
+ * RAMBlock/MemoryRegion ownership, unmapping and TLB/TB invalidation are unchanged.
+ */
+static void *ram_cache_take(struct uc_struct *uc, size_t size, uint64_t *align)
+{
+    size_t i;
+    if (uc->ram_cache_closing || size > UC_RAM_CACHE_MAX_BLOCK) {
+        return NULL;
+    }
+    for (i = 0; i < uc->ram_cache_count; i++) {
+        if (uc->ram_cache[i].size == size) {
+            void *host = uc->ram_cache[i].host;
+            *align = uc->ram_cache[i].align;
+            uc->ram_cache[i] = uc->ram_cache[--uc->ram_cache_count];
+            uc->ram_cache[uc->ram_cache_count].host = NULL;
+            uc->ram_cache_bytes -= size + uc->qemu_host_page_size;
+            if (size != uc->qemu_host_page_size) {
+                uc->ram_cache_other_bytes -= size + uc->qemu_host_page_size;
+            }
+            memset(host, 0, size);
+            return host;
+        }
+    }
+    return NULL;
+}
+
+static bool ram_cache_put(struct uc_struct *uc, RAMBlock *block)
+{
+    size_t i, charge;
+    if (uc->ram_cache_closing || !block->host ||
+        block->max_length > UC_RAM_CACHE_MAX_BLOCK || uc->qemu_host_page_size > UC_RAM_CACHE_MAX_BLOCK ||
+        uc->ram_cache_count == UC_RAM_CACHE_CAPACITY) {
+        return false;
+    }
+    charge = block->max_length + uc->qemu_host_page_size;
+    if (charge > UC_RAM_CACHE_BUDGET - uc->ram_cache_bytes) {
+        return false;
+    }
+    if (block->max_length != uc->qemu_host_page_size) {
+        if (charge > UC_RAM_CACHE_OTHER_BUDGET - uc->ram_cache_other_bytes) {
+            return false;
+        }
+        uc->ram_cache_other_bytes += charge;
+    }
+    i = uc->ram_cache_count++;
+    uc->ram_cache[i].host = block->host;
+    uc->ram_cache[i].size = block->max_length;
+    uc->ram_cache[i].align = block->mr->align;
+    uc->ram_cache_bytes += charge;
+    return true;
+}
+
 static void ram_block_add(struct uc_struct *uc, RAMBlock *new_block)
 {
