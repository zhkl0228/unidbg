+    jit_write_protect(uc->thread_executable_entry);
+    uc->current_executable = uc->thread_executable_entry;
     uc->nested -= 1;
 }
 #else
@@ -1086,15 +1081,14 @@ uc_err uc_emu_start(uc_engine *uc, uint64_t begin, uint64_t until,
