@@ -1211,6 +1205,7 @@ uc_err uc_emu_start(uc_engine *uc, uint64_t begin, uint64_t until,
         uc->hook_insert = 0;
         if (err != UC_ERR_OK) {
             uc->nested_level--;
+            restore_jit_state(uc);
             return err;
         }
     }
@@ -1237,10 +1232,10 @@ uc_err uc_emu_start(uc_engine *uc, uint64_t begin, uint64_t until,
         // remove hooks to delete
